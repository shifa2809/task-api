# Server
PORT=3000

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key - safe for client-facing operations (signup/login/token verification)
SUPABASE_ANON_KEY=your-anon-key

# Service role key - SERVER-SIDE ONLY, never expose to a client.
# Required for admin.signOut() so /auth/logout can actually revoke the session
# server-side instead of just relying on the client to discard the token.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
